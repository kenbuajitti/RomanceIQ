+// Run: node --test supabase/test/phase-a.test.mjs
+// This verifies the authored first three decisions and hashing still work.
+// It does not require (or modify) the live database or deployed gateway.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { thirdNode, validatePath, pathKey, normalizeChoices } from '../functions/romanceiq-story/logic.mjs';
+const story = JSON.parse(readFileSync(new URL('../functions/romanceiq-story/story.json', import.meta.url)));
+const sample = ['opening_choice:film', 'clip_choice:ask', 'decision_film_press:noah'];
+
+test('original three authored choices remain valid', () => {
+  const { path, ending } = validatePath(story, { storyId: story.storyId, storyVersion: story.version, path: sample });
+  assert.equal(path.length, 3);
+  assert.ok(ending.text.length > 150);
+  assert.equal(ending.id, thirdNode(story, sample).id);
+});
+
+test('there are still twelve unique authored paths before AI choices', () => {
+  const endings = new Set();
+  function walk(id, path = []) {
+    const node = story.nodes.find(n => n.id === id);
+    assert.ok(node, `Missing authored node: ${id}`);
+    if (path.length === 3) {
+      endings.add(validatePath(story, { storyId: story.storyId, storyVersion: story.version, path }).ending.id);
+      return;
+    }
+    if (node.choices?.length) {
+      for (const choice of node.choices) walk(choice.next, [...path, `${id}:${choice.id}`]);
+    } else {
+      assert.ok(node.next, `Premature ending: ${id}`);
+      walk(node.next, path);
+    }
+  }
+  walk(story.start);
+  assert.equal(endings.size, 12);
+});
+
+test('cache keys use existing namespace/version and remain stable', async () => {
+  const a = await pathKey(story, 'intro', sample);
+  assert.ok(a.startsWith('ri-v2-intro-'));
+  assert.equal(a, await pathKey(story, 'intro', sample));
+  assert.notEqual(a, await pathKey(story, 'scene', sample));
+});
+
+test('generator choices must stay three valid actions', () => {
+  const actions = normalizeChoices([{ text: 'Tell Noah now' }, { text: 'Wait until morning' }, { text: 'Ask Eli quietly' }]);
+  assert.equal(actions.length, 3);
+  assert.equal(new Set(actions.map(x => x.id)).size, 3);
+  assert.throws(() => normalizeChoices([{ text: 'Only one' }]));
+});
