@@ -0,0 +1,151 @@
+-- Phase A watchdog. Applies ONLY to ri-v2 RomanceIQ generated cache keys.
+-- Protects other games and authored content. Install BEFORE deploying the gateway.
+-- A pending row must be observed continuously for at least 10 minutes before a
+-- single automatic reset. One reset only; subsequent stalls require investigation.
+-- The 10-minute grace period exceeds published Supabase worker wall-clock limits.
+
+CREATE TABLE IF NOT EXISTS public.romanceiq_pending_watchdog (
+  path_key text PRIMARY KEY CHECK (path_key LIKE 'ri-v2-%'),
+  first_observed_at timestamptz NOT NULL DEFAULT now(),
+  resets integer NOT NULL DEFAULT 0 CHECK (resets BETWEEN 0 AND 1),
+  needs_claim boolean NOT NULL DEFAULT false
+);
+ALTER TABLE public.romanceiq_pending_watchdog ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.romanceiq_pending_watchdog FROM PUBLIC, anon, authenticated;
+
+CREATE OR REPLACE FUNCTION public.romanceiq_watch_pending(p_path_key text)
+RETURNS text
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = ''
+AS $$
+DECLARE
+  v_first timestamptz;
+  v_resets integer;
+  v_state text;
+  v_deleted integer;
+BEGIN
+  IF p_path_key IS NULL OR p_path_key NOT LIKE 'ri-v2-%' OR length(p_path_key) > 150 THEN
+    RAISE EXCEPTION 'Invalid RomanceIQ path key';
+  END IF;
+
+  INSERT INTO public.romanceiq_pending_watchdog(path_key)
+  VALUES (p_path_key)
+  ON CONFLICT(path_key) DO NOTHING;
+
+  SELECT first_observed_at, resets
+    INTO v_first, v_resets
+    FROM public.romanceiq_pending_watchdog
+    WHERE path_key = p_path_key FOR UPDATE;
+
+  SELECT generation_status INTO v_state
+    FROM public.story_nodes WHERE path_key = p_path_key;
+
+  IF v_state IS DISTINCT FROM 'pending' THEN
+    IF v_state = 'ready' THEN
+      DELETE FROM public.romanceiq_pending_watchdog WHERE path_key = p_path_key;
+    END IF;
+    RETURN coalesce(v_state, 'absent');
+  END IF;
+
+  IF now() - v_first < interval '10 minutes' THEN
+    RETURN 'pending';
+  END IF;
+
+  IF v_resets >= 1 THEN
+    RETURN 'stalled';
+  END IF;
+
+  DELETE FROM public.story_nodes
+    WHERE path_key = p_path_key AND generation_status = 'pending';
+  GET DIAGNOSTICS v_deleted = ROW_COUNT;
+  IF v_deleted = 0 THEN RETURN 'changed'; END IF;
+
+  UPDATE public.romanceiq_pending_watchdog
+    SET resets = resets + 1, first_observed_at = now(), needs_claim = true
+    WHERE path_key = p_path_key;
+  RETURN 'reset';
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.romanceiq_watch_pending(text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.romanceiq_watch_pending(text) TO service_role;
+
+-- Operator monitoring; use SQL editor:
+-- SELECT path_key, first_observed_at, resets,
+--        now() - first_observed_at AS observed_duration
+-- FROM public.romanceiq_pending_watchdog ORDER BY first_observed_at;
+
+-- Atomic claim prevents multiple gateway requests from generating the same
+-- missing path (and repeatedly consuming generation budget during polls).
+-- A claim also covers the interval BEFORE dynamic-function persists a pending row.
+CREATE OR REPLACE FUNCTION public.romanceiq_claim_generation(p_path_key text)
+RETURNS text
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = ''
+AS $$
+DECLARE
+  v_new integer;
+  v_first timestamptz;
+  v_resets integer;
+  v_needs_claim boolean;
+  v_status text;
+BEGIN
+  IF p_path_key IS NULL OR p_path_key NOT LIKE 'ri-v2-%' OR length(p_path_key) > 150 THEN
+    RAISE EXCEPTION 'Invalid RomanceIQ path key';
+  END IF;
+
+  INSERT INTO public.romanceiq_pending_watchdog(path_key)
+  VALUES(p_path_key) ON CONFLICT(path_key) DO NOTHING;
+  GET DIAGNOSTICS v_new = ROW_COUNT;
+
+  SELECT first_observed_at, resets, needs_claim
+    INTO v_first, v_resets, v_needs_claim
+    FROM public.romanceiq_pending_watchdog
+    WHERE path_key = p_path_key FOR UPDATE;
+
+  SELECT generation_status INTO v_status
+    FROM public.story_nodes WHERE path_key = p_path_key;
+  IF v_status = 'ready' THEN
+    DELETE FROM public.romanceiq_pending_watchdog WHERE path_key = p_path_key;
+    RETURN 'ready';
+  ELSIF v_status = 'pending' THEN
+    RETURN 'pending';
+  END IF;
+
+  IF v_needs_claim THEN
+    UPDATE public.romanceiq_pending_watchdog
+      SET needs_claim = false WHERE path_key = p_path_key;
+    RETURN 'claimed';
+  END IF;
+  IF v_new = 1 THEN RETURN 'claimed'; END IF;
+  IF now() - v_first < interval '10 minutes' THEN RETURN 'pending'; END IF;
+  IF v_resets >= 1 THEN RETURN 'stalled'; END IF;
+
+  UPDATE public.romanceiq_pending_watchdog
+    SET resets = resets + 1, first_observed_at = now()
+    WHERE path_key = p_path_key;
+  RETURN 'claimed';
+END;
+$$;
+REVOKE ALL ON FUNCTION public.romanceiq_claim_generation(text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.romanceiq_claim_generation(text) TO service_role;
+
+-- If a claim succeeds but budget is exhausted, no generation starts. Undo
+-- that claim only when there is no cached row, allowing a later fresh attempt.
+CREATE OR REPLACE FUNCTION public.romanceiq_release_unstarted_claim(p_path_key text)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path = ''
+AS $$
+DECLARE v_deleted integer;
+BEGIN
+  IF p_path_key IS NULL OR p_path_key NOT LIKE 'ri-v2-%' OR length(p_path_key) > 150 THEN
+    RAISE EXCEPTION 'Invalid RomanceIQ path key';
+  END IF;
+  DELETE FROM public.romanceiq_pending_watchdog
+    WHERE path_key = p_path_key AND NOT EXISTS
+    (SELECT 1 FROM public.story_nodes WHERE path_key = p_path_key);
+  GET DIAGNOSTICS v_deleted = ROW_COUNT;
+  RETURN v_deleted > 0;
+END;
+$$;
+REVOKE ALL ON FUNCTION public.romanceiq_release_unstarted_claim(text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.romanceiq_release_unstarted_claim(text) TO service_role;
